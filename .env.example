# === Dify Cloud 配置 ===
DIFY_API_KEY=app-xxxxxxxxxxxx
DIFY_API_URL=https://api.dify.ai/v1
DIFY_USER=whatsapp-agent

# === Supabase 配置（替代本地 JSON 文件）===
# 1. 登录 https://supabase.com 创建项目
# 2. 在 SQL Editor 中执行 supabase/migration.sql
# 3. 从 Settings → API 复制下面两行
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === WhatsApp 桥接配置 ===
WHITELIST_PHONES=

# === Railway 部署配置 ===
PUBLIC_URL=

# === 定时任务 ===
DAILY_REMINDER_TIME=09:00
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_TIME=20:00
MONTHLY_SUMMARY_DAY=1
MONTHLY_SUMMARY_TIME=20:00

# === 服务端口 ===
PORT=3000

# === n8n 配置（替换 Dify）===
# 部署 n8n 后，设置在 Railway 上的 Webhook URL
# WhatsApp Bridge 收到消息后会转发到这里
N8N_WEBHOOK_URL=https://your-n8n.up.railway.app/webhook/whatsapp-incoming
